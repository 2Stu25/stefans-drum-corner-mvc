
@using StefansDrumCorner.Web.Models.Content
@model ContentItem

@{
    ViewData["Title"] = "Add Content";

    int? selectedCategoryId =
        Model?.CategoryId ?? (int?)ViewBag.SelectedCategoryId;
}

<section class="content-manager">

    <header class="content-manager-header">

        <span class="account-label">PRIVATE ACCESS / CONTENT MANAGEMENT</span>

        <div class="content-manager-title-row">

            <h1>ADD NEW CONTENT</h1>

            <a asp-controller="Content"
               asp-action="Index"
               class="content-manager-back">
                BACK TO CONTENT LIBRARY
            </a>

        </div>

        <p>Create a new item for Stefan's Drum Corner.</p>

    </header>

    <form asp-controller="Content"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data"
          class="content-manager-form">

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="content-manager-form-layout">

            <!-- CONTENT DETAILS -->

            <section class="content-manager-panel content-manager-details-panel">

                <header class="content-manager-panel-heading">
                    <span>01 / CONTENT</span>
                    <h2>CONTENT DETAILS</h2>
                    <p>Describe and organise your content.</p>
                </header>

                <div class="form-group">
                    <label for="Title">TITLE</label>
                    <input type="text"
                           id="Title"
                           name="Title"
                           value="@Model?.Title"
                           required />
                    <span asp-validation-for="Title"></span>
                </div>

                <div class="form-group">
                    <label for="Description">DESCRIPTION</label>
                    <textarea id="Description"
                              name="Description"
                              rows="7">@Model?.Description</textarea>
                    <span asp-validation-for="Description"></span>
                </div>

                <div class="form-group">
                    <label for="CategoryId">CATEGORY</label>

                    <select id="CategoryId" name="CategoryId">
                        <option value="">SELECT CATEGORY</option>

                        @foreach (var category in (List<ContentCategory>)ViewBag.Categories)
                        {
                            <option value="@category.Id"
                                    selected="@(selectedCategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="Status">STATUS</label>

                    <select id="Status" name="Status">
                        @foreach (ContentStatus status in Enum.GetValues(typeof(ContentStatus)))
                        {
                            <option value="@status"
                                    selected="@(Model?.Status == status)">
                                @status
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Status"></span>
                </div>

                <div class="form-group">
                    <label for="DisplayOrder">DISPLAY ORDER</label>

                    <input type="number"
                           id="DisplayOrder"
                           name="DisplayOrder"
                           min="0"
                           value="@(Model?.DisplayOrder ?? 0)" />

                    <span asp-validation-for="DisplayOrder"></span>
                </div>

                <div class="form-group content-manager-featured">
                    <label for="IsFeatured">FEATURED CONTENT</label>

                    <input type="checkbox"
                           id="IsFeatured"
                           name="IsFeatured"
                           value="true"
                           checked="@(Model?.IsFeatured == true)" />
                </div>

            </section>

            <!-- MEDIA ATTACHMENTS -->

            <section class="content-manager-panel content-manager-media-panel">

                <header class="content-manager-panel-heading">
                    <span>ATTACHMENTS</span>
                    <h2>ATTACH MEDIA</h2>
                    <p>Select one or more files. File types are detected automatically.</p>
                </header>

                <div class="content-manager-media-fields">

                    <div class="form-group">
                        <label for="MediaFiles">SELECT MEDIA FILES</label>

                        <input type="file"
                               id="MediaFiles"
                               name="mediaFiles"
                               accept=".mp4,.webm,.mov,.jpg,.jpeg,.png,.webp,.mp3,.wav,.pdf"
                               multiple />

                        <small>
                            Videos: MP4, WebM, MOV.
                            Images: JPG, PNG, WebP.
                            Audio: MP3, WAV.
                            Documents: PDF.
                        </small>

                        <small>
                            You can select several files at once.
                            Each file will be classified automatically.
                        </small>
                    </div>

                </div>

            </section>

        </div>

        <!-- FORM ACTIONS -->

        <div class="content-manager-form-actions">

            <button type="submit" class="content-manager-create">
                SAVE CONTENT
            </button>

            <a asp-controller="Content"
               asp-action="Index"
               class="content-manager-back">
                CANCEL
            </a>

        </div>

    </form>

</section>
