
@using StefansDrumCorner.Web.Models.Content
@model List<ContentItem>

@{
    ViewData["Title"] = "Content Manager";

    var selectedItem = ViewBag.SelectedItem as ContentItem;

    var newContentItem = ViewBag.NewContentItem as ContentItem
        ?? new ContentItem();

    bool createMode = ViewBag.CreateMode is bool mode && mode;
    bool newCategoryMode = ViewBag.NewCategoryMode is bool newMode && newMode;
    bool showArchivedCategories = ViewBag.ShowArchivedCategories is bool archivedMode && archivedMode;
    bool categoriesView = ViewBag.CategoriesView is bool categoriesMode && categoriesMode;

    var editCategory = ViewBag.EditCategory as ContentCategory;

    var archivedCategories = ViewBag.ArchivedCategories as List<ContentCategory>
        ?? new List<ContentCategory>();

    var categories = ViewBag.Categories as List<ContentCategory>
        ?? new List<ContentCategory>();

    int? selectedCategoryId = ViewBag.SelectedCategoryId as int?;

    var selectedStatus = ViewBag.SelectedStatus?.ToString() ?? "";

    var rootCategories = categories
        .Where(c => c.ParentCategoryId == null)
        .OrderBy(c => c.DisplayOrder)
        .ThenBy(c => c.Name)
        .ToList();

    var selectedCategory = categories.FirstOrDefault(
        c => c.Id == selectedCategoryId);

    var categoryHeading = selectedCategory?.Name ?? "ALL CONTENT";

    var itemCount = Model?.Count ?? 0;

    var newCategory = ViewBag.NewCategory as ContentCategory
    ?? new ContentCategory();

    bool categoryFormMode = newCategoryMode || editCategory != null;
}


<div class="cm-workspace">

    <!-- TOP BAR -->
    <header class="cm-topbar">

        <div class="cm-topbar-main">

            <div class="cm-brand">
                <span class="cm-brand-mark">SDC</span>
                <span class="cm-brand-name">STEFAN'S DRUM CORNER</span>
            </div>

            <div class="cm-app-title">
                / CONTENT MANAGER
            </div>

            <div class="cm-admin-label">
                ADMIN
            </div>

        </div>

       
        <nav class="cm-top-menu">

            <a asp-controller="Content"
                asp-action="Index">
                File
            </a>

            <a asp-controller="Content"
                asp-action="Index"
                class="cm-top-menu-active">
                Content
            </a>

            <a asp-controller="Content"
               asp-action="Index"
               asp-route-categoriesView="true">
                Categories
            </a>

            <a asp-controller="Home"
                asp-action="Index"
                target="_blank"
                rel="noopener noreferrer"
                class="cm-view-website">
                <span>View Website</span>
                <span aria-hidden="true">↗</span>
            </a>

        </nav>


    </header>


    <!-- MAIN WORKSPACE -->
    <main class="cm-main">


<!-- LEFT PANEL: CATEGORY NAVIGATION -->
<aside class="cm-sidebar">

    <div class="cm-sidebar-heading">
        WORKSPACE
    </div>

    <div class="cm-category-heading">
        CATEGORIES
    </div>

    <div class="cm-category-actions">

        <a asp-controller="Content"
           asp-action="Index"
           asp-route-categoriesView="true"
           asp-route-newCategory="true"
           class="cm-category-create">
            + NEW CATEGORY
        </a>

        <a asp-controller="Content"
           asp-action="Index"
           asp-route-categoriesView="true"
           asp-route-showArchived="true"
           class="cm-category-action">
            ARCHIVE
        </a>

    </div>


    <!-- ALL CONTENT / ALL CATEGORIES -->
    <a asp-controller="Content"
       asp-action="Index"
       asp-route-categoriesView="@(categoriesView ? "true" : null)"
       class="cm-category-link cm-all-content-link @((categoriesView ? editCategory == null : selectedCategoryId == null && string.IsNullOrEmpty(selectedStatus)) && !showArchivedCategories ? "cm-category-selected" : "")">

        <span class="cm-category-link-name">
            @(categoriesView ? "All categories" : "All content")
        </span>

        <span class="cm-category-count">
            @(categoriesView ? categories.Count : itemCount)
        </span>

    </a>


    <!-- CATEGORY TREE -->
    <div class="cm-category-list">

        @foreach (var root in rootCategories)
        {
            var children = categories
                .Where(c => c.ParentCategoryId == root.Id)
                .OrderBy(c => c.DisplayOrder)
                .ThenBy(c => c.Name)
                .ToList();

            var isRootSelected = categoriesView
                ? editCategory?.Id == root.Id
                : selectedCategoryId == root.Id;

            var isChildSelected = categoriesView
                ? children.Any(c => c.Id == editCategory?.Id)
                : children.Any(c => c.Id == selectedCategoryId);

            var isGroupSelected = isRootSelected || isChildSelected;

            <details class="cm-category-group"
                     open="@(isGroupSelected ? "open" : null)">

                <summary class="cm-category-summary">

                    <span class="cm-category-chevron"></span>

                    <a asp-controller="Content"
                       asp-action="Index"
                       asp-route-categoriesView="@(categoriesView ? "true" : null)"
                       asp-route-categoryId="@(categoriesView ? null : root.Id)"
                       asp-route-editCategoryId="@(categoriesView ? root.Id : null)"
                       asp-route-status="@(categoriesView ? null : selectedStatus)"
                       class="cm-category-name @(isRootSelected ? "cm-category-selected" : "")"
                       onclick="event.stopPropagation();">

                        @root.Name

                    </a>

                    <span class="cm-category-count">
                        @children.Count
                    </span>

                </summary>

                <div class="cm-category-subcategories">

                    @foreach (var child in children)
                    {
                        var isSelected = categoriesView
                            ? editCategory?.Id == child.Id
                            : selectedCategoryId == child.Id;

                        <a asp-controller="Content"
                           asp-action="Index"
                           asp-route-categoriesView="@(categoriesView ? "true" : null)"
                           asp-route-categoryId="@(categoriesView ? null : child.Id)"
                           asp-route-editCategoryId="@(categoriesView ? child.Id : null)"
                           asp-route-status="@(categoriesView ? null : selectedStatus)"
                           class="cm-subcategory-link @(isSelected ? "cm-category-selected" : "")">

                            <span class="cm-category-link-name">
                                @child.Name
                            </span>

                        </a>
                    }

                </div>

            </details>
        }

    </div>


    @if (!categoriesView)
    {
        <div class="cm-sidebar-divider"></div>

        <!-- STATUS FILTERS -->
        <div class="cm-filter-heading">
            PUBLICATION
        </div>

        <nav class="cm-filter-nav">

            <a asp-controller="Content"
               asp-action="Index"
               asp-route-categoryId="@selectedCategoryId"
               asp-route-status=""
               class="cm-nav-item @(string.IsNullOrEmpty(selectedStatus) && !showArchivedCategories ? "cm-filter-active" : "")">

                <span>All</span>

            </a>

            <a asp-controller="Content"
               asp-action="Index"
               asp-route-categoryId="@selectedCategoryId"
               asp-route-status="Draft"
               class="cm-nav-item @(selectedStatus == "Draft" ? "cm-filter-active" : "")">

                <span class="cm-filter-dot cm-filter-dot-draft"></span>
                <span>Drafts</span>

            </a>

            <a asp-controller="Content"
               asp-action="Index"
               asp-route-categoryId="@selectedCategoryId"
               asp-route-status="Published"
               class="cm-nav-item @(selectedStatus == "Published" ? "cm-filter-active" : "")">

                <span class="cm-filter-dot cm-filter-dot-published"></span>
                <span>Published</span>

            </a>

        </nav>
    }

</aside>



        <!-- MIDDLE PANEL -->
        <section class="cm-content-panel">

            @if (showArchivedCategories)
            {
                <!-- ARCHIVED CATEGORIES -->

                <div class="cm-panel-heading">

                    <div class="cm-panel-heading-main">

                        <div class="cm-panel-section-label">
                            WORKSPACE
                        </div>

                        <h2 class="cm-panel-title">
                            CATEGORY ARCHIVE
                        </h2>

                        <div class="cm-panel-description">
                            @archivedCategories.Count @(archivedCategories.Count == 1 ? "archived category" : "archived categories")
                        </div>

                    </div>

                    <a asp-controller="Content"
                       asp-action="Index"
                       class="cm-new-button">
                        BACK TO CONTENT
                    </a>

                </div>


                <div class="cm-content-list">

                    @if (archivedCategories.Any())
                    {
                        @foreach (var archived in archivedCategories)
                        {
                            <div class="cm-content-item">

                                <div class="cm-item-main">

                                    <div class="cm-item-title">
                                        @archived.Name
                                    </div>

                                    <div class="cm-item-category">
                                        @(archived.ParentCategory?.Name ?? "Main category")
                                    </div>

                                </div>

                                <div class="cm-item-meta">

                                    <form asp-controller="Categories"
                                          asp-action="Restore"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@archived.Id" />

                                        <button type="submit"
                                                class="cm-save-button">
                                            RESTORE
                                        </button>

                                    </form>

                                    <form asp-controller="Categories"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Permanently delete this category? This cannot be undone.');">

                                        <input type="hidden"
                                               name="id"
                                               value="@archived.Id" />

                                        <button type="submit"
                                                class="cm-remove-media-button">
                                            DELETE
                                        </button>

                                    </form>

                                </div>

                            </div>

                            @foreach (var child in archived.SubCategories
                                .Where(c => !c.IsActive)
                                .OrderBy(c => c.DisplayOrder))
                            {
                                <div class="cm-content-item">

                                    <div class="cm-item-main">

                                        <div class="cm-item-title">
                                            &nbsp;&nbsp;↳ @child.Name
                                        </div>

                                        <div class="cm-item-category">
                                            Subcategory of @archived.Name
                                        </div>

                                    </div>

                                    <div class="cm-item-meta">

                                        <form asp-controller="Categories"
                                              asp-action="Restore"
                                              method="post">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@child.Id" />

                                            <button type="submit"
                                                    class="cm-save-button">
                                                RESTORE
                                            </button>

                                        </form>

                                        <form asp-controller="Categories"
                                              asp-action="Delete"
                                              method="post"
                                              onsubmit="return confirm('Permanently delete this category? This cannot be undone.');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@child.Id" />

                                            <button type="submit"
                                                    class="cm-remove-media-button">
                                                DELETE
                                            </button>

                                        </form>

                                    </div>

                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="cm-empty">

                            <div class="cm-empty-title">
                                Archive is empty
                            </div>

                            <p>
                                Archived categories will appear here.
                            </p>

                        </div>
                    }

                </div>
            }
            else
            {
            
@if (categoriesView)
{
    <!-- CATEGORY WORKSPACE -->

    <div class="cm-panel-heading">

        <div class="cm-panel-heading-main">

            <div class="cm-panel-section-label">
                WORKSPACE
            </div>

            <h2 class="cm-panel-title">
                CATEGORIES
            </h2>

            <div class="cm-panel-description">
                @categories.Count @(categories.Count == 1 ? "category" : "categories")
            </div>

        </div>

        <a asp-controller="Content"
           asp-action="Index"
           asp-route-categoriesView="true"
           asp-route-newCategory="true"
           class="cm-new-button">
            + NEW CATEGORY
        </a>

    </div>


    <div class="cm-content-list">

        @if (rootCategories.Any())
        {
            @foreach (var root in rootCategories)
            {
                var isRootSelected = editCategory?.Id == root.Id;

                <a asp-controller="Content"
                   asp-action="Index"
                   asp-route-categoriesView="true"
                   asp-route-editCategoryId="@root.Id"
                   class="cm-content-item @(isRootSelected ? "cm-content-item-selected" : "")">

                    <div class="cm-item-main">

                        <div class="cm-item-title">
                            @root.Name
                        </div>

                        <div class="cm-item-category">
                            MAIN CATEGORY
                        </div>

                    </div>

                    <div class="cm-item-meta">
                        <span class="cm-item-chevron">›</span>
                    </div>

                </a>

                @foreach (var child in categories
                    .Where(c => c.ParentCategoryId == root.Id)
                    .OrderBy(c => c.DisplayOrder)
                    .ThenBy(c => c.Name))
                {
                    var isChildSelected = editCategory?.Id == child.Id;

                    <a asp-controller="Content"
                       asp-action="Index"
                       asp-route-categoriesView="true"
                       asp-route-editCategoryId="@child.Id"
                       class="cm-content-item @(isChildSelected ? "cm-content-item-selected" : "")">

                        <div class="cm-item-main">

                            <div class="cm-item-title">
                                ↳ @child.Name
                            </div>

                            <div class="cm-item-category">
                                SUBCATEGORY OF @root.Name
                            </div>

                        </div>

                        <div class="cm-item-meta">
                            <span class="cm-item-chevron">›</span>
                        </div>

                    </a>
                }
            }
        }
        else
        {
            <div class="cm-empty">

                <div class="cm-empty-title">
                    No categories found
                </div>

                <p>
                    Create a category to get started.
                </p>

            </div>
        }

    </div>
}
else
{
    <!-- NORMAL CONTENT VIEW -->


                <div class="cm-panel-heading">

                    <div class="cm-panel-heading-main">

                        <div class="cm-panel-section-label">
                            CONTENT
                        </div>

                        @if (selectedCategory != null)
                        {
                            <a asp-controller="Content"
                               asp-action="Index"
                               asp-route-editCategoryId="@selectedCategory.Id"
                               asp-route-categoryId="@selectedCategory.Id"
                               class="cm-panel-title">

                                @categoryHeading

                            </a>
                        }
                        else
                        {
                            <h2 class="cm-panel-title">
                                @categoryHeading
                            </h2>
                        }

                        <div class="cm-panel-description">
                            @itemCount @(itemCount == 1 ? "item" : "items")
                        </div>

                    </div>


                    @if (!categoryFormMode)
                    {
                        <a asp-controller="Content"
                           asp-action="Index"
                           asp-route-create="true"
                           asp-route-categoryId="@selectedCategoryId"
                           class="cm-new-button">
                            + CREATE CONTENT
                        </a>
                    }

                </div>


                <!-- CONTENT LIST -->
                <div class="cm-content-list">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var isSelected = !createMode &&
                                selectedItem?.Id == item.Id;

                            var itemCategory = categories.FirstOrDefault(
                                c => c.Id == item.CategoryId);

                            <a asp-controller="Content"
                               asp-action="Index"
                               asp-route-selectedId="@item.Id"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-status="@selectedStatus"
                               class="cm-content-item @(isSelected ? "cm-content-item-selected" : "")">

                                <div class="cm-item-main">

                                    <div class="cm-item-title">
                                        @item.Title
                                    </div>

                                    <div class="cm-item-category">
                                        @(itemCategory?.Name ?? "Uncategorised")
                                    </div>

                                </div>

                                <div class="cm-item-meta">

                                    <span class="cm-status cm-status-@item.Status.ToString().ToLowerInvariant()">

                                        <span class="cm-status-dot"></span>

                                        @item.Status

                                    </span>

                                    <span class="cm-item-chevron">
                                        ›
                                    </span>

                                </div>

                            </a>
                        }
                    }
                    else
                    {
                        <div class="cm-empty">

                            <div class="cm-empty-title">
                                No content found
                            </div>

                            <p>
                                There are no content items matching this selection.
                            </p>

                        </div>
                    }

                       </div>
                    }
                }

                </section>



        <!-- RIGHT PANEL -->
        <section class="cm-properties-panel">


            @if (newCategoryMode)
            {
                <!-- NEW CATEGORY FORM -->

                <form asp-controller="Categories"
                      asp-action="Create"
                      method="post"
                      enctype="multipart/form-data"
                      class="cm-properties-form">

                    <div class="cm-properties-header">

                        <div>
                            <div class="cm-panel-section-label">
                                CATEGORY MANAGER
                            </div>

                            <h2 class="cm-properties-title">
                                NEW CATEGORY
                            </h2>
                        </div>

                    </div>


                    <div asp-validation-summary="All"
                         class="cm-validation-summary">
                    </div>


                    <div class="cm-property-section">

                        <div class="cm-property-section-heading">
                            GENERAL
                        </div>


                        <div class="cm-field">

                            <label for="Name">
                                CATEGORY NAME
                            </label>

                            <input type="text"
                               id="Name"
                               name="Name"
                               value="@newCategory.Name"
                               required />

                        </div>


                        <div class="cm-field">

                            <label for="Subtitle">
                                SUBTITLE
                            </label>

                            <input type="text"
                               id="Subtitle"
                               name="Subtitle"
                               value="@newCategory.Subtitle" />

                        </div>


                        <div class="cm-field">

                            <label for="Description">
                                DESCRIPTION
                            </label>

                            <textarea id="Description"
                                  name="Description"
                                  rows="5">@newCategory.Description</textarea>

                        </div>

                        <div class="cm-field">

                            <label for="ExploreLinkText">
                                EXPLORE LINK TEXT
                            </label>

                            <input type="text"
                                   id="ExploreLinkText"
                                   name="ExploreLinkText"
                                   value="@newCategory.ExploreLinkText"
                                   placeholder="e.g. EXPLORE PRACTICE" />

    <small>
        Link text displayed on the homepage category card.
        Mainly intended for main categories.
    </small>

</div>


                        <div class="cm-field">

                            <label for="ParentCategoryId">
                                PARENT CATEGORY
                            </label>

                            <select id="ParentCategoryId"
                                    name="ParentCategoryId">

                                <option value="">
                                    Main category
                                </option>

                                @foreach (var root in rootCategories)
                                {
                                    <option value="@root.Id"
                                            selected="@(newCategory.ParentCategoryId == root.Id ? "selected" : null)">
                                        @root.Name
                                    </option>
                                }

                            </select>

                            <small>
                                Leave this empty to create a main category.
                                Select a main category to create a subcategory.
                            </small>

                        </div>

                    </div>


                    <div class="cm-property-section">

                        <div class="cm-property-section-heading">
                            CATEGORY IMAGE
                        </div>

                        <div class="cm-field">

                            <label for="imageFile">
                                UPLOAD IMAGE
                            </label>

                            <input type="file"
                                   id="imageFile"
                                   name="imageFile"
                                   accept=".jpg,.jpeg,.png,.webp" />

                        </div>

                    </div>


                    <div class="cm-featured-field">
                        <label>
                            <input type="checkbox"
                               name="IsActive"
                               value="true"
                               checked="@newCategory.IsActive" />

                            <span>ACTIVE CATEGORY</span>
                        </label>
                    </div>

                    <input type="hidden" name="IsActive" value="false" />


                    <div class="cm-category-form-actions">

                        <a asp-controller="Content"
                           asp-action="Index"
                           class="cm-cancel-button">
                            CANCEL
                        </a>

                        <button type="submit"
                                class="cm-save-button">
                            CREATE CATEGORY
                        </button>

                    </div>

                </form>
            }

            else if (editCategory != null)
            {
                <!-- EDIT CATEGORY FORM -->

                <form asp-controller="Categories"
                      asp-action="Edit"
                      asp-route-id="@editCategory.Id"
                      method="post"
                      enctype="multipart/form-data"
                      class="cm-properties-form">

                    <input type="hidden"
                           name="Id"
                           value="@editCategory.Id" />


                    <div class="cm-properties-header">

                        <div>
                            <div class="cm-panel-section-label">
                                CATEGORY MANAGER
                            </div>

                            <h2 class="cm-properties-title">
                                EDIT CATEGORY
                            </h2>
                        </div>

                        <span class="cm-item-number">
                            #@editCategory.Id
                        </span>

                    </div>


                    <div asp-validation-summary="All"
                         class="cm-validation-summary">
                    </div>


                    <div class="cm-property-section">

                        <div class="cm-property-section-heading">
                            GENERAL
                        </div>


                        <div class="cm-field">

                            <label for="Name">
                                CATEGORY NAME
                            </label>

                            <input type="text"
                                   id="Name"
                                   name="Name"
                                   value="@editCategory.Name"
                                   required />

                        </div>


                        <div class="cm-field">

                            <label for="Subtitle">
                                SUBTITLE
                            </label>

                            <input type="text"
                                   id="Subtitle"
                                   name="Subtitle"
                                   value="@editCategory.Subtitle" />

                        </div>


                        <div class="cm-field">

                            <label for="Description">
                                DESCRIPTION
                            </label>

                            <textarea id="Description"
                                      name="Description"
                                      rows="5">@editCategory.Description</textarea>

                        </div>

                        <div class="cm-field">

                            <label for="ExploreLinkText">
                                EXPLORE LINK TEXT
                            </label>

                            <input type="text"
                                   id="ExploreLinkText"
                                   name="ExploreLinkText"
                                   value="@editCategory.ExploreLinkText"
                                   placeholder="e.g. EXPLORE PRACTICE" />

    <small>
        Link text displayed on the homepage category card.
        Mainly intended for main categories.
    </small>

</div>

                        <div class="cm-field">

                            <label for="ParentCategoryId">
                                PARENT CATEGORY
                            </label>

                            <select id="ParentCategoryId"
                                    name="ParentCategoryId">

                                <option value="">
                                    Main category
                                </option>

                                @foreach (var root in rootCategories.Where(c => c.Id != editCategory.Id))
                                {
                                    <option value="@root.Id"
                                            selected="@(editCategory.ParentCategoryId == root.Id ? "selected" : null)">
                                        @root.Name
                                    </option>
                                }

                            </select>

                        </div>

                    </div>


                    <div class="cm-property-section">

                        <div class="cm-property-section-heading">
                            CATEGORY IMAGE
                        </div>

                        @if (editCategory.Image != null)
                        {
                            <div class="cm-field">

                                <img src="@Url.Content("~/" + editCategory.Image.StorageKey)"
                                     alt="@editCategory.Name"
                                     style="max-width: 100%; max-height: 140px; object-fit: cover;" />

                                <label>
                                    <input type="checkbox"
                                           name="removeImage"
                                           value="true" />

                                    REMOVE CURRENT IMAGE
                                </label>

                            </div>
                        }

                        <div class="cm-field">

                            <label for="imageFile">
                                @(editCategory.Image == null ? "UPLOAD IMAGE" : "REPLACE IMAGE")
                            </label>

                            <input type="file"
                                   id="imageFile"
                                   name="imageFile"
                                   accept=".jpg,.jpeg,.png,.webp" />

                        </div>

                    </div>


                    <div class="cm-property-section">

                        <div class="cm-featured-field">

                            <label>
                                <input type="checkbox"
                                       name="IsActive"
                                       value="true"
                                       checked="@editCategory.IsActive" />

                                <span>ACTIVE CATEGORY</span>
                            </label>

                        </div>

                        <input type="hidden"
                               name="IsActive"
                               value="false" />

                    </div>


                    <div class="cm-category-form-actions">

                        <a asp-controller="Content"
                           asp-action="Index"
                           asp-route-categoryId="@editCategory.Id"
                           class="cm-cancel-button">
                            CANCEL
                        </a>

                        <button type="submit"
                                class="cm-save-button">
                            SAVE CATEGORY
                        </button>

                    </div>

                </form>
            }

            else if (createMode)
            {
                <!-- NEW CONTENT FORM -->

                <form id="createContentForm"
                      asp-controller="Content"
                      asp-action="Create"
                      method="post"
                      enctype="multipart/form-data"
                      class="cm-properties-form">

                    <div class="cm-properties-header">

                        <div>
                            <div class="cm-panel-section-label">
                                CONTENT MANAGER
                            </div>

                            <h2 class="cm-properties-title">
                                NEW CONTENT
                            </h2>
                        </div>

                    </div>


                    <div asp-validation-summary="All"
                         class="cm-validation-summary">
                    </div>


                    <div class="cm-property-section">

                        <div class="cm-property-section-heading">
                            GENERAL
                        </div>


                        <div class="cm-field">

                            <label for="Title">
                                TITLE
                            </label>

                            <input type="text"
                                   id="Title"
                                   name="Title"
                                   value="@newContentItem.Title"
                                   required />

                        </div>


                        <div class="cm-field">

                            <label for="CategoryId">
                                CATEGORY
                            </label>

                            <select id="CategoryId"
                                    name="CategoryId">

                                <option value="">
                                    Select category
                                </option>

                                @foreach (var root in rootCategories)
                                {
                                    <option value="@root.Id"
                                            selected="@(newContentItem.CategoryId == root.Id ? "selected" : null)">
                                        @root.Name
                                    </option>

                                    var children = categories
                                        .Where(c => c.ParentCategoryId == root.Id)
                                        .OrderBy(c => c.DisplayOrder)
                                        .ThenBy(c => c.Name)
                                        .ToList();

                                    foreach (var child in children)
                                    {
                                        <option value="@child.Id"
                                                selected="@(newContentItem.CategoryId == child.Id ? "selected" : null)">
                                            @root.Name / @child.Name
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <div class="cm-field">

                            <label for="Description">
                                DESCRIPTION
                            </label>

                            <textarea id="Description"
                                      name="Description"
                                      rows="5">@newContentItem.Description</textarea>

                        </div>


                        <div class="cm-field">

                            <label for="DisplayOrder">
                                DISPLAY ORDER
                            </label>

                            <input type="number"
                                   id="DisplayOrder"
                                   name="DisplayOrder"
                                   value="@newContentItem.DisplayOrder"
                                   min="0" />

                        </div>

                    </div>


                    <div class="cm-property-section">

                        <div class="cm-property-section-heading">
                            PUBLICATION
                        </div>


                        <div class="cm-publication-controls">

                            <div class="cm-field cm-status-field">

                                <label for="Status">
                                    STATUS
                                </label>

                                <select id="Status"
                                        name="Status">

                                    @foreach (ContentStatus status in Enum.GetValues(typeof(ContentStatus)))
                                    {
                                        <option value="@status"
                                                selected="@(newContentItem.Status == status ? "selected" : null)">
                                            @status
                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="cm-featured-field">

                                <input type="hidden"
                                       name="IsFeatured"
                                       value="false" />

                                <label for="IsFeatured">

                                    <input type="checkbox"
                                           id="IsFeatured"
                                           name="IsFeatured"
                                           value="true"
                                           checked="@newContentItem.IsFeatured" />

                                    <span>FEATURED CONTENT</span>

                                </label>

                            </div>

                        </div>

                    </div>

                </form>
            }

            else if (selectedItem != null)
            {
                <!-- EDIT EXISTING CONTENT FORM -->

                <form id="editContentForm"
                      asp-controller="Content"
                      asp-action="Edit"
                      asp-route-id="@selectedItem.Id"
                      method="post"
                      enctype="multipart/form-data"
                      class="cm-properties-form">

                    <input type="hidden"
                           name="Id"
                           value="@selectedItem.Id" />


                    <div class="cm-properties-header">

                        <div>
                            <div class="cm-panel-section-label">
                                CONTENT MANAGER
                            </div>

                            <h2 class="cm-properties-title">
                                EDIT CONTENT
                            </h2>
                        </div>

                        <span class="cm-item-number">
                            #@selectedItem.Id
                        </span>

                    </div>


                    <div asp-validation-summary="All"
                         class="cm-validation-summary">
                    </div>


                    <div class="cm-property-section">

                        <div class="cm-property-section-heading">
                            GENERAL
                        </div>


                        <div class="cm-field">

                            <label for="Title">
                                TITLE
                            </label>

                            <input type="text"
                                   id="Title"
                                   name="Title"
                                   value="@selectedItem.Title"
                                   required />

                        </div>


                        <div class="cm-field">

                            <label for="CategoryId">
                                CATEGORY
                            </label>

                            <select id="CategoryId"
                                    name="CategoryId"
                                    required>

                                <option value="">
                                    Select category
                                </option>

                                @foreach (var root in rootCategories)
                                {
                                    <option value="@root.Id"
                                            selected="@(selectedItem.CategoryId == root.Id ? "selected" : null)">
                                        @root.Name
                                    </option>

                                    var children = categories
                                        .Where(c => c.ParentCategoryId == root.Id)
                                        .OrderBy(c => c.DisplayOrder)
                                        .ThenBy(c => c.Name)
                                        .ToList();

                                    foreach (var child in children)
                                    {
                                        <option value="@child.Id"
                                                selected="@(selectedItem.CategoryId == child.Id ? "selected" : null)">
                                            @root.Name / @child.Name
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <div class="cm-field">

                            <label for="Description">
                                DESCRIPTION
                            </label>

                            <textarea id="Description"
                                      name="Description"
                                      rows="5">@selectedItem.Description</textarea>

                        </div>


                        <div class="cm-field">

                            <label for="DisplayOrder">
                                DISPLAY ORDER
                            </label>

                            <input type="number"
                                   id="DisplayOrder"
                                   name="DisplayOrder"
                                   value="@selectedItem.DisplayOrder"
                                   min="0" />

                        </div>

                    </div>


                    <div class="cm-property-section">

                        <div class="cm-property-section-heading">
                            PUBLICATION
                        </div>


                        <div class="cm-publication-controls">

                            <div class="cm-field cm-status-field">

                                <label for="Status">
                                    STATUS
                                </label>

                                <select id="Status"
                                        name="Status">

                                    @foreach (ContentStatus status in Enum.GetValues(typeof(ContentStatus)))
                                    {
                                        <option value="@status"
                                                selected="@(selectedItem.Status == status ? "selected" : null)">
                                            @status
                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="cm-featured-field">

                                <input type="hidden"
                                       name="IsFeatured"
                                       value="false" />

                                <label for="IsFeatured">

                                    <input type="checkbox"
                                           id="IsFeatured"
                                           name="IsFeatured"
                                           value="true"
                                           checked="@selectedItem.IsFeatured" />

                                    <span>FEATURED CONTENT</span>

                                </label>

                            </div>

                        </div>

                    </div>

                </form>
            }

            else
            {
                <div class="cm-no-selection">

                    <div class="cm-no-selection-title">
                        NO ITEM SELECTED
                    </div>

                    <p>
                        Select an item from the content list to view and edit its properties.
                    </p>

                </div>
            }

        </section>



        @if (selectedItem != null || createMode)
        {
            <!-- FULL WIDTH MEDIA FOOTER -->
            <section class="cm-media-footer">


                <!-- EXISTING ATTACHMENTS -->
                <div class="cm-media-footer-existing">

                    <div class="cm-media-footer-heading">
                        ATTACHED MEDIA
                    </div>

                    @if (selectedItem != null &&
                         selectedItem.ContentMedia != null &&
                         selectedItem.ContentMedia.Any())
                    {
                        <div class="cm-media-footer-list">

                            @foreach (var media in selectedItem.ContentMedia)
                            {
                                <div class="cm-media-footer-row">

                                    <span class="cm-media-role">
                                        @media.Role:
                                    </span>

                                    <span class="cm-media-filename">
                                        @media.MediaAsset?.OriginalFileName
                                    </span>

                                    <span class="cm-media-details">
                                        @media.MediaAsset?.MediaType

                                        @if (media.MediaAsset != null)
                                        {
                                            <text> · @((media.MediaAsset.FileSizeBytes / 1024.0).ToString("N0")) KB</text>
                                        }
                                    </span>


                                    <form asp-controller="Content"
                                          asp-action="RemoveMedia"
                                          method="post"
                                          class="cm-remove-media-form">

                                        <input type="hidden"
                                               name="contentItemId"
                                               value="@selectedItem.Id" />

                                        <input type="hidden"
                                               name="mediaId"
                                               value="@media.Id" />

                                        <details class="cm-remove-confirm">

                                            <summary class="cm-remove-media-button">
                                                REMOVE
                                            </summary>

                                            <div class="cm-remove-confirm-panel">

                                                <span>
                                                    Remove this attachment?
                                                </span>

                                                <div class="cm-remove-confirm-actions">

                                                    <button type="button"
                                                            class="cm-remove-cancel"
                                                            onclick="this.closest('details').open = false">
                                                        CANCEL
                                                    </button>

                                                    <button type="submit"
                                                            class="cm-remove-confirm-button">
                                                        CONFIRM REMOVE
                                                    </button>

                                                </div>

                                            </div>

                                        </details>

                                    </form>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="cm-no-media">
                            No media attached.
                        </div>
                    }

                </div>



                <!-- ADD MEDIA -->
                <div class="cm-media-footer-add">

                    <div class="cm-media-footer-heading">
                        ADD MEDIA
                    </div>

                    <p class="cm-upload-description">
                        Select one or more files.
                    </p>

                    <input type="file"
                           id="MediaFiles"
                           name="mediaFiles"
                           form="@(createMode ? "createContentForm" : "editContentForm")"
                           accept=".mp4,.webm,.mov,.jpg,.jpeg,.png,.webp,.mp3,.wav,.pdf"
                           multiple />

                    <small>
                        Videos: MP4, WebM, MOV.
                        Images: JPG, PNG, WebP.
                        Audio: MP3, WAV.
                        Documents: PDF.
                    </small>


                    <div class="cm-media-footer-actions">

                        @if (createMode)
                        {
                            <a asp-controller="Content"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-status="@selectedStatus"
                               class="cm-cancel-button">
                                CANCEL
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Content"
                               asp-action="Index"
                               asp-route-selectedId="@selectedItem!.Id"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-status="@selectedStatus"
                               class="cm-cancel-button">
                                CANCEL
                            </a>
                        }


                        <button type="submit"
                                form="@(createMode ? "createContentForm" : "editContentForm")"
                                class="cm-save-button">

                            @(createMode ? "CREATE CONTENT" : "SAVE CHANGES")

                        </button>

                    </div>

                </div>

            </section>
        }

    </main>



    <!-- STATUS BAR -->
    <footer class="cm-statusbar">

        <div class="cm-statusbar-left">

            <span class="cm-ready-indicator"></span>

            CONTENT MANAGER READY

        </div>

        <div class="cm-statusbar-right">
            STEFAN'S DRUM CORNER
        </div>

    </footer>

</div>
