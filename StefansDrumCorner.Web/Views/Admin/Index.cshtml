@model List<StefansDrumCorner.Web.Models.Content.ContentCategory>

@{
    ViewData["Title"] = "Content Manager";
}

<section class="admin-dashboard">

    <header class="admin-dashboard-header">

        <span class="account-label">PRIVATE ACCESS / ADMINISTRATION</span>

        <div class="admin-dashboard-title-row">

            <h1>CONTENT MANAGER</h1>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="admin-logout-form">

                <button type="submit" class="admin-logout-button">
                    SIGN OUT
                </button>

            </form>

        </div>

        <p>Manage the content and media on Stefan's Drum Corner.</p>

        <a asp-controller="Categories"
           asp-action="Create"
           class="content-manager-create">
            + ADD CATEGORY
        </a>

    </header>

    @foreach (var category in Model)
    {
        <div class="admin-dashboard-section">

            <h2>
                <a asp-controller="Categories"
                   asp-action="Details"
                   asp-route-id="@category.Id"
                   class="admin-category-link">

                    <span>@category.DisplayOrder.ToString("00") /</span>
                    @category.Name.ToUpperInvariant()

                </a>
            </h2>

            <p>@category.Subtitle</p>

            @if (category.SubCategories.Any())
            {
                <div class="admin-dashboard-subcategories">

                    @foreach (var subCategory in category.SubCategories.OrderBy(s => s.DisplayOrder))
                    {
                        <div class="admin-dashboard-subcategory">
                            @subCategory.Name
                        </div>
                    }

                </div>
            }

        </div>
    }

</section>
