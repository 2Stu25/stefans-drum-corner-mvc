@model List<StefansDrumCorner.Web.Models.Content.ContentCategory>

@{
    ViewData["Title"] = "Content Manager";
}

<section class="admin-dashboard">

    <header class="admin-dashboard-header">

        <span class="account-label">PRIVATE ACCESS / ADMINISTRATION</span>

        <div class="admin-dashboard-title-row">

            <h1>CONTENT MANAGER</h1>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="admin-logout-form">

                <button type="submit" class="admin-logout-button">
                    SIGN OUT
                </button>

            </form>

        </div>

        <p>Manage the content and media on Stefan's Drum Corner.</p>

        <a asp-controller="Categories"
           asp-action="Create"
           class="content-manager-create">
            + ADD CATEGORY
        </a>

        <a asp-controller="Categories"
           asp-action="Archived"
           class="content-manager-back">
            VIEW ARCHIVED CATEGORIES →
        </a>

    </header>

    @foreach (var category in Model)
    {
        <div class="admin-dashboard-section">

            @if (category.SubCategories.Any())
            {
                <details class="admin-category-group">

                    <summary class="admin-category-summary">

                        <span class="admin-category-number">
                            @category.DisplayOrder.ToString("00") /
                        </span>

                        @category.Name.ToUpperInvariant()

                    </summary>

                    <p>@category.Subtitle</p>

                    <div class="admin-dashboard-subcategories">

                        <div class="admin-subcategory-label">
                            SUBCATEGORIES
                        </div>

                        @foreach (var subCategory in category.SubCategories.OrderBy(s => s.DisplayOrder))
                        {
                            <div class="admin-dashboard-subcategory admin-subcategory-row">

                                <span>@subCategory.Name</span>

                                <a asp-controller="Content"
                                   asp-action="Create"
                                   asp-route-categoryId="@subCategory.Id"
                                   class="admin-add-content-link">
                                    + ADD CONTENT →
                                </a>

                            </div>
                        }

                        <a asp-controller="Categories"
                           asp-action="Create"
                           asp-route-parentId="@category.Id"
                           class="admin-add-subcategory-link">
                            + ADD SUBCATEGORY →
                        </a>

                    </div>

                </details>
            }
            else
            {
                <div class="admin-category-heading-row">

                    <h2>
                        <a asp-controller="Content"
                           asp-action="Create"
                           asp-route-categoryId="@category.Id"
                           class="admin-category-link">

                            <span>@category.DisplayOrder.ToString("00") /</span>
                            @category.Name.ToUpperInvariant()

                        </a>
                    </h2>

                    <a asp-controller="Content"
                       asp-action="Create"
                       asp-route-categoryId="@category.Id"
                       class="admin-add-content-link">
                        + ADD CONTENT →
                    </a>

                </div>

                <p>@category.Subtitle</p>
            }

        </div>
    }

</section>