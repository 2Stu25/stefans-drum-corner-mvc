@{
    ViewData["Title"] = "Practice Lab";
}

<div class="practice-lab-page">

    <!-- PAGE INTRODUCTION -->
    <header class="practice-lab-header">

        <div class="practice-lab-kicker">
            02 / PRACTICE LAB
        </div>

        <h1>Technique, Training &amp; Development</h1>

        <p class="practice-lab-intro">
            Exploring the mechanics of drumming. Practice pad techniques,
            grip variations, sticking, weighted training and exercises
            for developing control, strength and precision.
        </p>

        <div class="practice-lab-rule"></div>

    </header>


    <!-- SUBJECT AREAS -->
    <section class="practice-lab-topics">

        <div class="practice-lab-section-heading">
            <span>EXPLORE THE LAB</span>
            <span class="practice-lab-section-number">01 — 04</span>
        </div>

        <div class="practice-lab-topic-grid">

            <a href="#practice-pad" class="practice-lab-topic">
                <span class="topic-number">01</span>
                <h2>Practice Pad</h2>
                <p>
                    Rebound, dynamics, precision and developing
                    hand technique.
                </p>
                <span class="topic-arrow">EXPLORE &rsaquo;</span>
            </a>

            <a href="#grip-sticking" class="practice-lab-topic">
                <span class="topic-number">02</span>
                <h2>Grip &amp; Sticking</h2>
                <p>
                    Traditional grip, matched grip, sticking
                    patterns and rudiments.
                </p>
                <span class="topic-arrow">EXPLORE &rsaquo;</span>
            </a>

            <a href="#weighted-training" class="practice-lab-topic">
                <span class="topic-number">03</span>
                <h2>Weighted Training</h2>
                <p>
                    Weighted practice sticks, wrist weights
                    and training experiments.
                </p>
                <span class="topic-arrow">EXPLORE &rsaquo;</span>
            </a>

            <a href="#exercises-studies" class="practice-lab-topic">
                <span class="topic-number">04</span>
                <h2>Exercises &amp; Studies</h2>
                <p>
                    Original exercises, etudes, coordination
                    and musical studies.
                </p>
                <span class="topic-arrow">EXPLORE &rsaquo;</span>
            </a>

        </div>

    </section>


    <!-- PRACTICE MATERIAL -->
    <section class="practice-lab-materials">

        <div class="practice-lab-section-heading">
            <span>FROM THE PRACTICE ROOM</span>
            <span class="practice-lab-section-number">LATEST MATERIAL</span>
        </div>


        <!-- VIDEO STUDY -->
        <article class="practice-lab-material" id="exercises-studies">

            <div class="material-video">

                <video controls preload="metadata"
                       playsinline>
                    <source src="@Url.Content("~/videos/sdjmalik-etude-web.mp4")"
                            type="video/mp4">
                    Your browser does not support HTML5 video.
                </video>

            </div>

            <div class="material-description">

                <div class="material-category">
                    EXERCISES &amp; STUDIES
                    <span> / VIDEO STUDY</span>
                </div>

                <h2>SDJ Malik Etude</h2>

                <p>
                    A technical study performed on the practice pad.
                    An exploration of sticking, control and precision
                    through a structured musical exercise.
                </p>

                <div class="material-meta">
                    <span>FORMAT: VIDEO</span>
                    <span>INSTRUMENT: DRUMS</span>
                    <span>TYPE: PRACTICE PAD</span>
                </div>

            </div>

        </article>

    </section>


    <!-- FUTURE CONTENT AREAS -->
    <section class="practice-lab-more">

        <div id="practice-pad" class="practice-lab-anchor">
            <span>01</span>
            <h2>Practice Pad</h2>
            <p>
                Developing control, rebound, dynamics and precision.
            </p>
        </div>

        <div id="grip-sticking" class="practice-lab-anchor">
            <span>02</span>
            <h2>Grip &amp; Sticking</h2>
            <p>
                Exploring traditional grip, matched grip and
                different sticking approaches.
            </p>
        </div>

        <div id="weighted-training" class="practice-lab-anchor">
            <span>03</span>
            <h2>Weighted Training</h2>
            <p>
                Experiments with stainless steel practice sticks
                and weighted training methods.
            </p>
        </div>

    </section>

</div>
