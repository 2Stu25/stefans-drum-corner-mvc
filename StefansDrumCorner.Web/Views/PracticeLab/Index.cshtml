
@using StefansDrumCorner.Web.Models.Content
@using System.Linq
@using System.IO

@{
    ViewData["Title"] = "Practice Lab";

    var category = ViewBag.Category as ContentCategory;

    var subCategories =
        (ViewBag.SubCategories as IEnumerable<ContentCategory>
            ?? Enumerable.Empty<ContentCategory>())
        .OrderBy(c => c.DisplayOrder)
        .ToList();

    var contentItems =
        (ViewBag.ContentItems as IEnumerable<ContentItem>
            ?? Enumerable.Empty<ContentItem>())
        .ToList();
}

<div class="practice-lab-page">

    <!-- PAGE INTRODUCTION -->
    <header class="practice-lab-header">

        <div class="practice-lab-kicker">
            02 / PRACTICE LAB
        </div>

        <h1>Technique, Training &amp; Development</h1>

        <p class="practice-lab-intro">
            Exploring the mechanics of drumming. Practice pad techniques,
            grip variations, sticking, weighted training and exercises
            for developing control, strength and precision.
        </p>

        <div class="practice-lab-rule"></div>

    </header>


    <!-- SUBJECT AREAS -->
    <section class="practice-lab-topics">

        <div class="practice-lab-section-heading">
            <span>EXPLORE THE LAB</span>
            <span class="practice-lab-section-number">01 — 04</span>
        </div>

        <div class="practice-lab-topic-grid">

            @foreach (var collection in subCategories)
            {
                <a href="#@collection.Slug"
                   class="practice-lab-topic">

                    <span class="topic-number">
                        @collection.DisplayOrder.ToString("00")
                    </span>

                    <h2>@collection.Name</h2>

                    @if (!string.IsNullOrWhiteSpace(collection.Description))
                    {
                        <p>@collection.Description</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(collection.Subtitle))
                    {
                        <p>@collection.Subtitle</p>
                    }

                    <span class="topic-arrow">EXPLORE &rsaquo;</span>

                </a>
            }

        </div>

    </section>


    <!-- PRACTICE MATERIAL -->
    <section class="practice-lab-materials">

        <div class="practice-lab-section-heading">
            <span>FROM THE PRACTICE ROOM</span>
            <span class="practice-lab-section-number">LATEST MATERIAL</span>
        </div>
                @foreach (var item in contentItems
                    .Where(item =>
                        item.CategoryId.HasValue &&
                        subCategories.Any(c => c.Id == item.CategoryId.Value))
                    .OrderBy(item => item.DisplayOrder)
                    .ThenBy(item => item.Title))
                {
                    var collection = subCategories
                        .First(c => c.Id == item.CategoryId!.Value);

                    var firstItemInCollectionId = contentItems
                        .Where(x => x.CategoryId == collection.Id)
                        .OrderBy(x => x.DisplayOrder)
                        .ThenBy(x => x.Title)
                        .Select(x => x.Id)
                        .FirstOrDefault();

                    var articleId = !string.IsNullOrWhiteSpace(item.Slug)
                        ? item.Slug
                        : $"practice-item-{item.Id}";

                    var articleAnchorId = item.Id == firstItemInCollectionId
                        ? collection.Slug
                        : articleId;

                    var attachments = item.ContentMedia?
                        .Where(m => m.MediaAsset != null)
                        .OrderBy(m => m.DisplayOrder)
                        .ToList()
                        ?? new List<ContentMedia>();

                    var mainVideo = attachments
                        .FirstOrDefault(m => m.Role == MediaRole.MainVideo)
                        ?.MediaAsset;

                    var thumbnail = attachments
                        .FirstOrDefault(m => m.Role == MediaRole.Thumbnail)
                        ?.MediaAsset;

                    var documents = attachments
                        .Where(m => m.Role == MediaRole.Document)
                        .ToList();

                    var galleryImage = attachments
                        .FirstOrDefault(m => m.Role == MediaRole.GalleryImage)
                        ?.MediaAsset;

                    var displayImage = thumbnail ?? galleryImage;

                    

                    var hasDocuments = documents.Any();
                    var hasVideo = mainVideo != null;
                    var hasImage = displayImage != null;

                    var categoryName = collection.Name;

                    var formatLabel = hasVideo
                        ? (hasDocuments ? "VIDEO STUDY" : "VIDEO")
                        : hasImage
                            ? "PRACTICE MATERIAL"
                            : "STUDY MATERIAL";


                    @if (hasVideo && hasDocuments)
                    {
                        <!-- VIDEO ARTICLE WITH SHEET MUSIC -->

                        <article class="practice-lab-material is-active"
                                 id="@articleAnchorId"
                                 data-practice-item>

                            <div class="material-video">

                                <video controls
                                       preload="metadata"
                                       playsinline>

                                    <source src="@Url.Content("~/" + mainVideo.StorageKey.TrimStart('/'))"
                                            type="@mainVideo.ContentType">

                                    Your browser does not support HTML5 video.

                                </video>

                            </div>


                            <div class="material-description">

                                <div class="material-category">
                                    @categoryName
                                    <span> / @formatLabel</span>
                                </div>

                                <h2>@item.Title</h2>

                                <p>@item.Description</p>


                                <div class="sheet-music-actions">

                                    <div class="sheet-music-heading">
                                        SHEET MUSIC
                                    </div>

                                    @foreach (var document in documents)
                                    {
                                        var fileName = document.MediaAsset.OriginalFileName;

                                        var documentLabel =
                                            !string.IsNullOrWhiteSpace(document.Caption)
                                                ? document.Caption
                                                : fileName.Contains("original", StringComparison.OrdinalIgnoreCase)
                                                    ? "FULL ETUDE"
                                                    : fileName.Contains("extended", StringComparison.OrdinalIgnoreCase)
                                                        ? "STUDY VERSION"
                                                        : System.IO.Path.GetFileNameWithoutExtension(fileName);

                                        <button type="button"
                                                class="sheet-music-link"
                                                data-bs-toggle="modal"
                                                data-bs-target="#sheetMusicModal"
                                                data-pdf="@Url.Content("~/" + document.MediaAsset.StorageKey.TrimStart('/'))">

                                            <span>
                                                @((documents.IndexOf(document) + 1).ToString("00"))
                                            </span>

                                            @documentLabel

                                            <span class="sheet-music-format">
                                                PDF ↗
                                            </span>

                                        </button>
                                    }

                                </div>


                                <div class="material-meta">
                                    <span>FORMAT: VIDEO</span>
                                    <span>ATTACHMENTS: @documents.Count PDF</span>
                                    <span>TYPE: @categoryName.ToUpperInvariant()</span>
                                </div>

                            </div>

                        </article>
                    }
                    else if (hasVideo)
                    {
                        <!-- EXPANDABLE VIDEO ARTICLE -->

                        <article class="practice-lab-material material-placeholder video-expandable"
                                 id="@articleAnchorId"
                                 data-practice-item>

                            <button type="button"
                                    class="video-minimize-button"
                                    aria-label="Minimize video"
                                    title="Minimize video">
                                −
                            </button>


                            <div class="material-placeholder-visual video-preview">

                                <video class="material-thumbnail-video"
                                       preload="metadata"
                                       playsinline
                                       @if (hasImage)
                                       {
                                           <text>poster="@Url.Content("~/" + displayImage.StorageKey.TrimStart('/'))"</text>
                                       }>

                                    <source src="@Url.Content("~/" + mainVideo.StorageKey.TrimStart('/'))"
                                            type="@mainVideo.ContentType">

                                    Your browser does not support HTML5 video.

                                </video>


                                <button type="button"
                                        class="video-play-button"
                                        aria-label="Expand and play video">

                                    <span class="video-play-icon"></span>

                                </button>

                                <span class="video-thumbnail-label">
                                    VIDEO
                                </span>

                            </div>


                            <div class="material-description">

                                <div class="material-category">
                                    @categoryName
                                    <span> / @formatLabel</span>
                                </div>

                                <h2>@item.Title</h2>

                                <p>@item.Description</p>


                                <div class="material-meta">
                                    <span>FORMAT: VIDEO</span>
                                    <span>INSTRUMENT: DRUMS</span>
                                    <span>TYPE: @categoryName.ToUpperInvariant()</span>
                                </div>

                            </div>

                        </article>
                    }
                    else if (hasImage)
                    {
                        <!-- IMAGE / PRACTICE MATERIAL -->

                        <article class="practice-lab-material material-placeholder"
                                 id="@articleAnchorId"
                                 data-practice-item>

                            <div class="material-placeholder-visual">

                                <img src="@Url.Content("~/" + displayImage.StorageKey.TrimStart('/'))"
                                     alt="@(displayImage.AltText ?? item.Title)"
                                     asp-append-version="true">

                                <div class="video-thumbnail-overlay">

                                    <span class="video-thumbnail-label">
                                        PRACTICE MATERIAL
                                    </span>

                                </div>

                            </div>


                            <div class="material-description">

                                <div class="material-category">
                                    @categoryName
                                    <span> / @formatLabel</span>
                                </div>

                                <h2>@item.Title</h2>

                                <p>@item.Description</p>


                                <div class="material-meta">
                                    <span>FORMAT: IMAGE</span>
                                    <span>INSTRUMENT: DRUMS</span>
                                    <span>TYPE: @categoryName.ToUpperInvariant()</span>
                                </div>

                            </div>

                        </article>
                    }
                    else
                    {
                        <!-- ARTICLE WITHOUT MEDIA -->

                        <article class="practice-lab-material"
                                 id="@articleAnchorId"
                                 data-practice-item>

                            <div class="material-description">

                                <div class="material-category">
                                    @categoryName
                                    <span> / STUDY MATERIAL</span>
                                </div>

                                <h2>@item.Title</h2>

                                <p>@item.Description</p>

                            </div>

                        </article>
                    }
              
          

        }


        <!-- CONTENT ASSIGNED DIRECTLY TO THE MAIN PRACTICE LAB CATEGORY -->

        @{
            var mainCategoryItems = contentItems
                .Where(item => item.CategoryId == category.Id)
                .OrderBy(item => item.DisplayOrder)
                .ThenBy(item => item.Title)
                .ToList();
        }

        @if (mainCategoryItems.Any())
        {
            <div id="practice-lab-main"
                 class="practice-lab-anchor">

                <span>00</span>
                <h2>@category.Name</h2>

            </div>

            @foreach (var item in mainCategoryItems)
            {
                <article class="practice-lab-material"
                         id="@item.Slug">

                    <div class="material-description">

                        <div class="material-category">
                            @category.Name
                        </div>

                        <h2>@item.Title</h2>

                        <p>@item.Description</p>

                    </div>

                </article>
            }
        }

    </section>


    <!-- PDF VIEWER MODAL -->

    <div class="modal fade"
         id="sheetMusicModal"
         tabindex="-1"
         data-bs-backdrop="false"
         data-bs-keyboard="false"
         data-bs-scroll="true">

        <div class="modal-dialog modal-xl modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title" id="sheetMusicModalLabel">
                        Sheet Music
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="pdf-viewer">

                        <div class="pdf-toolbar">

                            <button type="button"
                                    id="pdfPrevPage"
                                    class="pdf-control">
                                PREVIOUS
                            </button>

                            <span id="pdfPageInfo">
                                Page 0 of 0
                            </span>

                            <button type="button"
                                    id="pdfNextPage"
                                    class="pdf-control">
                                NEXT
                            </button>


                            <div class="pdf-zoom-controls">

                                <button type="button"
                                        id="pdfZoomOut"
                                        class="pdf-control">
                                    −
                                </button>

                                <span id="pdfZoomLevel">100%</span>

                                <button type="button"
                                        id="pdfZoomIn"
                                        class="pdf-control">
                                    +
                                </button>

                            </div>

                        </div>


                        <div class="pdf-canvas-container">
                            <canvas id="pdfCanvas"></canvas>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>

</div>


<script type="module">

    import * as pdfjsLib from '/lib/pdfjs/build/pdf.mjs';

    pdfjsLib.GlobalWorkerOptions.workerSrc =
        '/lib/pdfjs/build/pdf.worker.mjs';


    const modal = document.getElementById('sheetMusicModal');
    const canvas = document.getElementById('pdfCanvas');
    const container = document.querySelector('.pdf-canvas-container');

    const ctx = canvas.getContext('2d');

    const prevButton = document.getElementById('pdfPrevPage');
    const nextButton = document.getElementById('pdfNextPage');
    const zoomOutButton = document.getElementById('pdfZoomOut');
    const zoomInButton = document.getElementById('pdfZoomIn');

    const pageInfo = document.getElementById('pdfPageInfo');
    const zoomLevel = document.getElementById('pdfZoomLevel');


    let pdfDocument = null;
    let currentPage = 1;
    let zoom = 1;
    let renderTask = null;
    let pdfUrl = null;


    // Select the PDF belonging to the clicked button.

    document.querySelectorAll(
        '[data-bs-target="#sheetMusicModal"][data-pdf]'
    ).forEach(button => {

        button.addEventListener('click', function () {
            pdfUrl = this.getAttribute('data-pdf');
        });

    });


    modal.addEventListener('show.bs.modal', function (event) {

        const trigger = event.relatedTarget;

        if (trigger?.hasAttribute('data-pdf')) {
            pdfUrl = trigger.getAttribute('data-pdf');
        }

    });


    // Load the selected PDF after the modal is visible.

    modal.addEventListener('shown.bs.modal', async function () {

        if (!pdfUrl) {
            console.error('No PDF file selected.');
            pageInfo.textContent = 'No PDF selected';
            return;
        }

        try {

            const loadingTask = pdfjsLib.getDocument({
                url: pdfUrl
            });

            pdfDocument = await loadingTask.promise;

            currentPage = 1;
            zoom = 1;

            await renderPage();

        } catch (error) {

            console.error('PDF loading error:', error);
            pageInfo.textContent = 'Unable to load PDF';

        }

    });


    // Render the current PDF page.

    async function renderPage() {

        if (!pdfDocument) return;

        if (renderTask) {
            renderTask.cancel();
            renderTask = null;
        }

        const page = await pdfDocument.getPage(currentPage);

        const baseViewport = page.getViewport({ scale: 1 });

        const availableWidth = container.clientWidth - 40;

        const fitScale = availableWidth / baseViewport.width;

        const scale = fitScale * zoom;

        const viewport = page.getViewport({ scale });

        const pixelRatio = window.devicePixelRatio || 1;

        canvas.width = Math.floor(viewport.width * pixelRatio);
        canvas.height = Math.floor(viewport.height * pixelRatio);

        canvas.style.width = `${viewport.width}px`;
        canvas.style.height = `${viewport.height}px`;

        const renderContext = {
            canvasContext: ctx,
            viewport: viewport,
            transform: pixelRatio !== 1
                ? [pixelRatio, 0, 0, pixelRatio, 0, 0]
                : null
        };

        renderTask = page.render(renderContext);

        try {

            await renderTask.promise;

        } catch (error) {

            if (error.name !== 'RenderingCancelledException') {
                throw error;
            }

        }

        pageInfo.textContent =
            `Page ${currentPage} of ${pdfDocument.numPages}`;

        zoomLevel.textContent = `${Math.round(zoom * 100)}%`;

        prevButton.disabled = currentPage <= 1;
        nextButton.disabled = currentPage >= pdfDocument.numPages;

    }


    // Previous page.

    prevButton.addEventListener('click', async function () {

        if (currentPage > 1) {
            currentPage--;
            await renderPage();
        }

    });


    // Next page.

    nextButton.addEventListener('click', async function () {

        if (pdfDocument && currentPage < pdfDocument.numPages) {
            currentPage++;
            await renderPage();
        }

    });


    // Zoom in.

    zoomInButton.addEventListener('click', async function () {

        if (zoom < 2) {
            zoom = Math.min(2, zoom + 0.1);
            await renderPage();
        }

    });


    // Zoom out.

    zoomOutButton.addEventListener('click', async function () {

        if (zoom > 0.5) {
            zoom = Math.max(0.5, zoom - 0.1);
            await renderPage();
        }

    });


    // Reset the viewer when the modal closes.

    modal.addEventListener('hidden.bs.modal', function () {

        if (renderTask) {
            renderTask.cancel();
            renderTask = null;
        }

        pdfDocument = null;
        pdfUrl = null;
        currentPage = 1;
        zoom = 1;

        canvas.width = 0;
        canvas.height = 0;

        pageInfo.textContent = 'Page 0 of 0';
        zoomLevel.textContent = '100%';

    });


    // EXPANDABLE VIDEO ARTICLES

    document.querySelectorAll(".video-expandable").forEach(article => {

        const video = article.querySelector("video");
        const preview = article.querySelector(".video-preview");
        const playButton = article.querySelector(".video-play-button");
        const minimizeButton = article.querySelector(".video-minimize-button");

        if (!video || !preview || !playButton || !minimizeButton) return;


        // Detect original video dimensions and aspect ratio.

        video.addEventListener("loadedmetadata", () => {

            const width = video.videoWidth;
            const height = video.videoHeight;

            if (width && height) {

                preview.style.setProperty(
                    "--video-aspect-ratio",
                    `${width} / ${height}`
                );

            }

        });


        // Expand article and start playback.

        function expandVideo() {

            article.classList.add("is-expanded");

            video.controls = true;
            playButton.hidden = true;

            video.play().catch(error => {

                console.warn("Video playback could not start:", error);
                playButton.hidden = false;

            });

        }


        // Pause video and restore compact layout.

        function minimizeVideo() {

            video.pause();
            video.currentTime = 0;
            video.controls = false;

            article.classList.remove("is-expanded");
            playButton.hidden = false;

        }


        // Clicking the article expands it.

        article.addEventListener("click", event => {

            if (article.classList.contains("is-expanded")) return;

            if (event.target.closest("button")) return;

            expandVideo();

        });


        // Play button.

        playButton.addEventListener("click", event => {

            event.stopPropagation();
            expandVideo();

        });


        // Minimize button.

        minimizeButton.addEventListener("click", event => {

            event.stopPropagation();
            minimizeVideo();

        });

    });

</script>
