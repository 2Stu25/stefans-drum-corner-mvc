
@{
    ViewData["Title"] = "Home";
}

<main class="home-page">

    <!-- MAIN EDITORIAL FEATURE -->

    <section class="editorial-hero">

        <div class="container editorial-hero-grid">

            <div class="editorial-hero-content">

                <span class="editorial-label">THE DRUM CORNER</span>

                <h1>EXPLORE MY DRUM WORLD</h1>

                <p>
                    Gear, technique, practice and ideas from a lifetime
                    <br />
                    behind the kit.
                </p>

                <a href="#practice-room" class="editorial-button">
                    EXPLORE THE CORNER
                </a>

            </div>

            <div class="editorial-hero-image">

                <img src="~/images/stefan-hero.png"
                     alt="Stefan behind his drum kit"
                     asp-append-version="true" />

                <button class="wig-hotspot" type="button" aria-label="Reveal a secret">
                    <span>WIG DETECTED! 😂</span>
                </button>

            </div>

        </div>

    </section>


    <!-- MAIN CONTENT AREA -->

    <div class="container home-content-grid">

        <div class="home-main-column">



<!-- EXPLORE THE DRUM CORNER -->

<section class="editorial-section" id="explore">

    <div class="section-heading">

        <div>
            <span class="editorial-label">EXPLORE</span>
            <h2>Explore the Drum Corner</h2>
        </div>

        <a href="#explore" class="section-link">
            EXPLORE ALL →
        </a>

    </div>


    <div class="article-grid">

        <!-- VIDEOS -->

        <article class="article-card" id="videos">

            <div class="article-image">
                <img src="~/images/stefan-videos.png"
                     alt="Stefan playing drums"
                     asp-append-version="true" />
            </div>

            <div class="article-content">

                <span class="article-category">
                    01 / VIDEOS
                </span>

                <h3>Drumming Demonstrations</h3>

                <p>
                    Chops, exercises, rudiments and playing
                    demonstrations on the drum kit.
                </p>

                <a href="#videos">WATCH VIDEOS →</a>

            </div>

        </article>


        <!-- PRACTICE LAB -->

        <article class="article-card" id="practice-lab">

            <div class="article-image">
                <span>IMAGE 02</span>
            </div>

            <div class="article-content">

                <span class="article-category">
                    02 / PRACTICE LAB
                </span>

                <h3>Technique & Development</h3>

                <p>
                    Rudiments, sticking, coordination,
                    polymeters and structured exercises.
                </p>

                <a asp-controller="PracticeLab" asp-action="Index">
                    EXPLORE PRACTICE →
                </a>

            </div>

        </article>


        <!-- GEAR ROOM -->

        <article class="article-card" id="gear-room">

            <div class="article-image">
                <img src="~/images/drum-gear.png"
                     alt="Drummer surrounded by Tama drums"
                     asp-append-version="true" />
            </div>

            <div class="article-content">

                <span class="article-category">
                    03 / GEAR ROOM
                </span>

                <h3>Equipment & Recording</h3>

                <p>
                    Drum kits, cymbals, sticks, hardware,
                    microphones and recording equipment.
                </p>

                <a href="#gear-room">EXPLORE GEAR →</a>

            </div>

        </article>


        <!-- DRUM TOOLS -->

        <article class="article-card" id="drum-tools">

            <div class="article-image">
                <span>IMAGE 04</span>
            </div>

            <div class="article-content">

                <span class="article-category">
                    04 / DRUM TOOLS
                </span>

                <h3>Software & Utilities</h3>

                <p>
                    Custom C++ applications, MuseScore scripts
                    and practical tools for drummers.
                </p>

                <a href="#drum-tools">EXPLORE TOOLS →</a>

            </div>

        </article>

    </div>

</section>



            <!-- ABOUT FEATURE -->

            <section class="about-feature" id="about">

                <div class="about-image">
                    <img src="~/images/stefan-about.png"
                         alt="Stefan behind his Tama drum kit"
                         asp-append-version="true" />
                </div>

                <div class="about-content">

                    <span class="editorial-label">ABOUT STEFAN</span>

                    <h2>A Lifetime Behind the Drums</h2>

                    <p>
                        From rock bands and recording to drumming
                        experiences and musical exploration.
                        This is a place for sharing what I've learned
                        and what I'm still discovering.
                    </p>

                    <a href="#about">READ MY STORY →</a>

                </div>

            </section>

        </div>


        <!-- SIDEBAR -->

        <aside class="home-sidebar">


            <!-- GEAR ROOM -->

            <section class="sidebar-feature sidebar-feature-dark">
                     

                <span class="sidebar-label">GEAR ROOM</span>

                <h2>Drum Kit, Cymbals & Sticks</h2>

                <p>
                    Explore my drum kit, cymbals, drumsticks,
                    collection and more.
                </p>

                <a href="#gear-room">VIEW GEAR →</a>

            </section>


            <!-- USED GEAR RESEARCH -->

            <section class="sidebar-feature sidebar-feature-light">

                <span class="editorial-label">FEATURE</span>

                <h2>Used Gear Price Research</h2>

                <p>
                    Real sold prices from the second-hand market.
                    Compare brands, models and trends.
                </p>

                <a href="#gear-room">LEARN MORE →</a>

            </section>


            <!-- DOWNLOADS -->

            <section class="sidebar-feature sidebar-feature-light"
                     id="downloads">

                <span class="editorial-label">DOWNLOADS</span>

                <h2>Tools for Better Practice</h2>

                <p>
                    Sheet music, exercises and useful tools
                    for your development.
                </p>

                <a href="#downloads">BROWSE DOWNLOADS →</a>

            </section>


        </aside>

    </div>

</main>

