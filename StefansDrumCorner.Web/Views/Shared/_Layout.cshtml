<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StefansDrumCorner.Web</title>

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StefansDrumCorner.Web.styles.css" asp-append-version="true" />
</head>
<body>

    
   

    <header class="site-header">

        <!-- MASTHEAD -->

        <div class="site-masthead">
            <div class="container masthead-grid">

                <a class="masthead-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="masthead-title">
                        STEFAN'S
                        <span>DRUM CORNER</span>
                    </span>

                </a>

                <div class="masthead-description">
                    <span>DRUMS</span>
                    <span>TECHNIQUE</span>
                    <span>GEAR</span>
                    <span>PRACTICE</span>
                </div>

                <div class="masthead-tagline">
                    <span>BETTER TIMING</span>
                    <span>BETTER SOUNDS</span>
                    <span>BETTER DRUMMING</span>
                    <span class="tagline-star">★</span>
                </div>

            </div>
        </div>


        <!-- MAIN NAVIGATION -->

        <nav class="navbar navbar-expand-md drum-navbar">
            <div class="container">

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">HOME</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="videos">VIDEOS</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="practice-lab">PRACTICE LAB</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="gear-room">GEAR ROOM</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="drum-tools">DRUM TOOLS</a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>

    </header>




    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container footer-copyright">
            <span>&copy; 2026 -</span>

            <img src="~/images/stefans-nameplate.png"
                 alt="Stefan Eksteen"
                 class="footer-signature" />
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
